# Production environment. Copy to `.env` ON THE SERVER and fill in.
#
# NEVER COMMIT THE FILLED-IN VERSION. `.env` and `.env.*` are gitignored, and
# the repository is PUBLIC (C45) -- anything pushed here is world-readable.
#
# `config/settings/prod.py` REFUSES TO START if the four values marked REQUIRED
# below are missing or still at their development defaults. That is deliberate:
# each one fails far from its cause otherwise, and one of them (the secret key)
# fails silently and permanently.

# DJANGO_SETTINGS_MODULE IS DELIBERATELY NOT SET HERE, and that is not an
# oversight. It would do nothing: `manage.py` runs
# `os.environ.setdefault("DJANGO_SETTINGS_MODULE", "config.settings.dev")` on
# line 10, BEFORE any settings module is imported -- and this file is only read
# from inside `base.py`, by which time the choice has already been made. A line
# here would look load-bearing and silently leave every management command on
# dev settings.
#
# It is set in two real places instead:
#   - the systemd units, as a genuine environment variable before the process
#     starts (Gunicorn and Celery)
#   - `--settings=config.settings.prod` on every `manage.py` command you run by
#     hand, which is also how the project's own dev commands are written

# REQUIRED. Generate a fresh one, never reuse the development key:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# DJANGO_DEBUG IS NOT HERE EITHER, and for a better reason than the settings
# module above: `prod.py` sets `DEBUG = False` as a constant, after the star
# import, so the environment cannot reach it. That is deliberate.
#
# DEBUG is a safety property, not a preference. With it on, any unhandled
# error returns a page carrying the settings, the SQL and the local variables
# -- which in a multi-tenant system means another organisation's data shape
# shown to whoever triggered the error. A typo in this file must not be able
# to do that, so it is not a knob this file owns.
#
# (`base.py` still reads DJANGO_DEBUG, and nothing uses the result: both dev.py
# and prod.py overwrite it. The variable is inert in every environment.)

# REQUIRED. The hostnames this server answers to, comma separated. Django
# returns 400 for any host not listed, which reads like the server being down.
# Use the real domain; do NOT add "*".
DJANGO_ALLOWED_HOSTS=app.example.com

# REQUIRED. Where the SPA is served from -- which in production is this same
# host, because Nginx serves the built frontend and proxies /api/ to Gunicorn.
#
# TWO THINGS DEPEND ON IT: invitation links are built against it (C56), and
# `prod.py` derives CSRF_TRUSTED_ORIGINS from it. An empty value means no
# invitation can be handed out at all -- `invitation_link()` raises rather than
# building a relative URL.
#
# MUST be https:// and must have no trailing slash.
FRONTEND_BASE_URL=https://app.example.com

LOG_LEVEL=INFO

# --- Control database -------------------------------------------------------
#
# Tenant databases are created per organization at runtime (C1) and are not
# listed here; they come from the `Organization` registry. The user below needs
# the privilege to CREATE them -- see `scripts/create_prod_db.sql`.

MYSQL_DB=xpredict_control
MYSQL_USER=xpredict
# REQUIRED. Must not be the development password, which is public.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# --- Redis ------------------------------------------------------------------
#
# Three logical databases on one Redis: broker, results, cache. Redis listens
# on loopback only (see the runbook), so no password is set -- if you ever move
# Redis off this host, add one and put it in these URLs.
#
# THE CACHE IS NOT OPTIONAL. DRF keeps throttle history there, so an
# unreachable cache is a 500 on the throttled endpoints rather than "no rate
# limiting" -- which is how nine sessions of pointing at an uninstalled Redis
# finally surfaced.

CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
REDIS_CACHE_URL=redis://127.0.0.1:6379/2

# Must stay False. `prod.py` refuses to start otherwise: eager means tenant
# provisioning runs inside the signup request.
CELERY_TASK_ALWAYS_EAGER=False
