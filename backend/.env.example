# Copy to .env and fill in. .env is gitignored; this file is committed.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=generate-a-real-one-for-anything-but-local
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# Control database. Tenant databases are created per organization at runtime
# and are not listed here --- they come from the Organization.db_alias registry.
POSTGRES_DB=xpredict_control
POSTGRES_USER=xpredict
POSTGRES_PASSWORD=xpredict
# 6432 is PgBouncer; connect to 5432 only to bypass the pool deliberately.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=6432

CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
REDIS_CACHE_URL=redis://127.0.0.1:6379/2
CELERY_TASK_ALWAYS_EAGER=False
