# Copy to .env and fill in. .env is gitignored; this file is committed.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=generate-a-real-one-for-anything-but-local
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# Control database (MySQL 8.0.11+, see C39). Tenant databases are created per
# organization at runtime and are not listed here --- they come from the
# Organization.db_alias registry.
MYSQL_DB=xpredict_control
MYSQL_USER=xpredict
MYSQL_PASSWORD=xpredict
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
REDIS_CACHE_URL=redis://127.0.0.1:6379/2
CELERY_TASK_ALWAYS_EAGER=False
