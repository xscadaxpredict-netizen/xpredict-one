[Unit]
Description=Xpredict One - Gunicorn (Django)
Documentation=https://github.com/xscadaxpredict-netizen/xpredict-one
# WANTS, NOT REQUIRES, for MySQL and Redis. `Requires` would stop Django
# whenever MySQL restarts, and a database that comes back should not need the
# web tier restarted by hand. Django reconnects per request (CONN_MAX_AGE=0),
# so it recovers on its own.
After=network.target mysql.service redis-server.service
Wants=mysql.service redis-server.service

[Service]
Type=notify
User=xpredict

# GROUP IS www-data, NOT xpredict, AND THE FIRST DEPLOYMENT TURNS ON IT.
#
# systemd gives RuntimeDirectory the unit's OWN User and Group. This said
# `Group=xpredict` for four sessions while the comment two lines down claimed
# www-data, so /run/xpredict came out xpredict:xpredict 0750 -- and www-data has
# no search permission on a directory it does not own and is not in the group
# of. It cannot reach the socket inside, so EVERY request to /api/ is a 502 with
# "permission denied" in the Nginx error log. Nothing in deploy/README.md adds
# www-data to the xpredict group, so there was no second mechanism saving it;
# the troubleshooting table listed the symptom and nothing prevented the cause.
#
# This costs nothing elsewhere. The process still runs as User=xpredict, so
# OWNER permissions carry staticfiles, media and the 600-mode .env regardless of
# the group. Uploads it writes come out group www-data, which is what Nginx
# needs to read them back out anyway.
Group=www-data
WorkingDirectory=/srv/xpredict/backend

# The socket lives in /run/xpredict, created by systemd on each start and
# removed on stop. 0750 with the group above lets Nginx connect and nothing
# else.
RuntimeDirectory=xpredict
RuntimeDirectoryMode=0750

# `.env` IS READ BY DJANGO ITSELF, not by systemd. `base.py` calls
# `environ.Env.read_env(BASE_DIR / ".env")`, so the file is loaded from
# WorkingDirectory above. Listing it here as well would mean two loaders and
# two chances to disagree about quoting.
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
Environment=PYTHONUNBUFFERED=1

ExecStart=/srv/xpredict/backend/.venv/bin/gunicorn \
    --config /srv/xpredict/deploy/gunicorn.conf.py \
    config.wsgi:application

# Graceful reload on `systemctl reload`: finishes in-flight requests, then
# starts new workers. This is what a deploy should use -- `restart` drops
# whatever was mid-request.
ExecReload=/bin/kill -s HUP $MAINPID

Restart=always
RestartSec=5

# Hardening. None of this is exotic; it is the set that costs nothing for a
# service that reads its own directory and talks to localhost.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# The only paths it may write to: the socket directory, and staticfiles when
# `collectstatic` runs under this unit's user.
ReadWritePaths=/srv/xpredict/backend/staticfiles /srv/xpredict/backend/media
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
